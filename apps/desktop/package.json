{
  "name": "@circuit-platform/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs\"",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.cjs",
    "test:temporal-e2e": "node --test --experimental-strip-types tests/temporal-e2e.test.ts",
    "test:multidocument-e2e": "electron scripts/multidocument-e2e.mjs",
    "test:embedded-snapshot-e2e": "electron scripts/embedded-snapshot-e2e.mjs",
    "test:subcircuit-library-probe": "electron scripts/subcircuit-library-probe.mjs",
    "test:embedded-definition-navigation-e2e": "electron scripts/embedded-definition-navigation-e2e.mjs",
    "test:canvas-selection": "electron scripts/canvas-selection-regression.mjs",
    "performance:benchmark": "node scripts/performance-benchmark.mjs",
    "visual:test": "electron scripts/visual-regression.mjs",
    "visual:probe": "electron scripts/visual-state-probe.mjs"
  },
  "dependencies": {
    "@circuit-platform/protocol": "workspace:*",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}

{
  "name": "@circuit-platform/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs\"",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.cjs"
  },
  "dependencies": {
    "@circuit-platform/protocol": "workspace:*",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
